# =================================================================
# tenant-encrypted-datalake — environment configuration
# =================================================================

# --- Required for ingestion / proxy ---

# Path to master key file (32-byte raw key). Generate with:
#   npm run build && npm run generate-master-key
MASTER_KEY_PATH=./keys/master.key

# Path to encrypted DB credentials file. Optional — if absent, ingestion
# falls back to PG_USER/PG_PASSWORD/MYSQL_USER/MYSQL_PASSWORD env vars.
DB_CREDENTIALS_PATH=./keys/db-credentials.enc

# Path to the tenants config JSON. Start from config/tenants.example.json.
TENANTS_PATH=./config/tenants.json


# --- HKDF / crypto ---

# Domain separator for HKDF tenant key derivation. SET ONCE — changing this
# invalidates every previously encrypted tenant file.
HKDF_SALT=tenant-encrypted-datalake-v1


# --- Cloudflare R2 (or any S3-compatible object storage) ---
# Required to actually upload encrypted Parquet. If absent, ingestion runs
# in dry-run mode (extract + transform only, no upload).

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional custom endpoint; defaults to https://${R2_ACCOUNT_ID}.r2.cloudflarestorage.com
R2_ENDPOINT=


# --- Ingestion runtime ---

# Cron schedule for the orchestrator. Default: every 30 minutes.
INGESTION_CRON=*/30 * * * *

# Batch size (rows) per DB query. Higher = fewer round-trips, more RAM.
INGESTION_BATCH_SIZE=10000

# Cap rows per table per cycle (safety net for accidentally huge scans).
MAX_ROWS_PER_TABLE=100000


# --- DuckDB proxy ---

PROXY_PORT=4500
PROXY_HOST=127.0.0.1

# Local working dir where decrypted Parquet files are cached while DuckDB
# reads them. Files are removed after CACHE_TTL_MS (5 min).
PROXY_TMP_DIR=/tmp/datalake-proxy


# --- State / cache / logs (defaults to ./cache and ./logs) ---

STATE_PATH=./cache/ingestion-state.json
LOCKS_DIR=./cache/locks
LOG_DIR=./logs
LOG_LEVEL=info


# --- Fallback DB credentials (used when DB_CREDENTIALS_PATH is missing,
# OR when a tenant has no `credentialKey` in tenants.json) ---

PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=readonly_datalake
PG_PASSWORD=

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=readonly_datalake
MYSQL_PASSWORD=
