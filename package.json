{
  "name": "tenant-encrypted-datalake",
  "version": "1.0.0",
  "description": "Multi-tenant data lake with per-tenant client-side encryption (HKDF + AES-256-GCM). Ingests Postgres / MySQL, encrypts, stores Parquet in S3-compatible object storage (Cloudflare R2), exposes a SELECT-only DuckDB proxy with per-tenant HMAC auth and automatic tenant_id filter injection.",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "pipeline": "node dist/ingestion/pipeline.js",
    "orchestrator": "node dist/ingestion/orchestrator.js",
    "proxy": "node dist/proxy/server.js",
    "generate-master-key": "node dist/security/keystore.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.990.0",
    "@aws-sdk/lib-storage": "^3.990.0",
    "dotenv": "^17.3.1",
    "duckdb": "^1.4.4",
    "fastify": "^5.7.4",
    "mysql2": "^3.17.1",
    "node-cron": "^4.2.1",
    "pg": "^8.18.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "@types/pg": "^8.16.0",
    "typescript": "^5.9.3"
  }
}
